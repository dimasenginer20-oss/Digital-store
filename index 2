<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">

  <title>DigitalStore - Toko Digital</title>

  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background: #0b0d12;
      color: white;
      line-height: 1.5;
    }

    header {
      padding: 60px 20px;
      text-align: center;
      background: linear-gradient(135deg, #151a2b, #0b0d12);
      border-bottom: 1px solid #252b3a;
    }

    .logo {
      font-size: 40px;
      font-weight: 800;
      color: #7c9cff;
      margin-bottom: 10px;
    }

    header p {
      color: #a9b0c0;
      font-size: 15px;
    }

    .badge {
      display: inline-block;
      margin-top: 18px;
      padding: 8px 15px;
      border: 1px solid #30384d;
      border-radius: 50px;
      color: #b8c3dd;
      font-size: 13px;
    }

    .container {
      max-width: 1050px;
      margin: auto;
      padding: 30px 20px;
    }

    .section-title {
      font-size: 27px;
      margin-bottom: 20px;
    }

    .products {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 18px;
    }

    .card {
      background: #151821;
      border: 1px solid #282e3d;
      border-radius: 18px;
      padding: 22px;
      transition: 0.2s;
    }

    .card:hover {
      transform: translateY(-4px);
      border-color: #637fe0;
    }

    .icon {
      font-size: 35px;
      margin-bottom: 12px;
    }

    .card h3 {
      font-size: 19px;
      margin-bottom: 8px;
    }

    .card p {
      color: #9ca5b8;
      font-size: 14px;
      min-height: 45px;
    }

    .price {
      color: #8ea7ff;
      font-size: 17px;
      font-weight: bold;
      margin: 18px 0;
    }

    .order-btn {
      display: block;
      width: 100%;
      padding: 12px;
      background: #637fe0;
      color: white;
      text-decoration: none;
      text-align: center;
      border-radius: 11px;
      font-weight: bold;
      transition: 0.2s;
    }

    .order-btn:hover {
      background: #7891ee;
    }

    .info {
      margin-top: 30px;
      padding: 22px;
      background: #151821;
      border: 1px solid #282e3d;
      border-radius: 18px;
      color: #aeb6c8;
    }

    .info h3 {
      color: white;
      margin-bottom: 10px;
    }

    .info ul {
      padding-left: 20px;
    }

    footer {
      text-align: center;
      padding: 35px 20px;
      color: #70798c;
      border-top: 1px solid #202532;
      margin-top: 30px;
    }

    @media (max-width: 500px) {
      .logo {
        font-size: 32px;
      }

      .container {
        padding: 25px 15px;
      }
    }
  </style>
</head>

<body>

  <!-- HEADER -->
  <header>
    <div class="logo">SMM Store</div>

    <p>
      Toko layanan digital cepat, mudah, dan praktis
    </p>

    <div class="badge">
      Followers • Likes • Up Votes
    </div>
  </header>


  <!-- PRODUK -->
  <main class="container">

    <h2 class="section-title">
      Produk Kami
    </h2>

    <div class="products">


      <!-- WHATSAPP FOLLOWER -->
      <div class="card">

        <div class="icon">💬</div>

        <h3>
          Follower Saluran WhatsApp
        </h3>

        <p>
          Tambah follower untuk saluran WhatsApp kamu.
        </p>

        <div class="price">
          Mulai Rp6.000
        </div>

        <a
          class="order-btn"
          href="https://wa.me/6285165197664?text=Halo%20SMMStore%2C%20saya%20mau%20order%20Follower%20Saluran%20WhatsApp"
          target="_blank"
        >
          Order Sekarang
        </a>

      </div>


      <!-- INSTAGRAM FOLLOWER -->
      <div class="card">

        <div class="icon">📸</div>

        <h3>
          Follower Instagram
        </h3>

        <p>
          Tambah follower untuk akun Instagram kamu.
        </p>

        <div class="price">
          Mulai Rp7.000
        </div>

        <a
          class="order-btn"
          href="https://wa.me/6285165197664?text=Halo%20SMMStore%2C%20saya%20mau%20order%20Follower%20Instagram"
          target="_blank"
        >
          Order Sekarang
        </a>

      </div>


      <!-- TIKTOK LIKE -->
      <div class="card">

        <div class="icon">🎵</div>

        <h3>
          Like TikTok
        </h3>

        <p>
          Tambah like untuk video TikTok kamu.
        </p>

        <div class="price">
          Mulai Rp3.500
        </div>

        <a
          class="order-btn"
          href="https://wa.me/6285165197664?text=Halo%20DigitalStore%2C%20saya%20mau%20order%20Like%20TikTok"
          target="_blank"
        >
          Order Sekarang
        </a>

      </div>


      <!-- INSTAGRAM LIKE -->
      <div class="card">

        <div class="icon">❤️</div>

        <h3>
          Like Instagram
        </h3>

        <p>
          Tambah like untuk postingan Instagram.
        </p>

        <div class="price">
          Mulai Rp3.500
        </div>

        <a
          class="order-btn"
          href="https://wa.me/6285165197664?text=Halo%20SMMStore%2C%20saya%20mau%20order%20Like%20Instagram"
          target="_blank"
        >
          Order Sekarang
        </a>

      </div>


      <!-- WHATSAPP UP VOTE -->
      <div class="card">

        <div class="icon">⬆️</div>

        <h3>
          Up Votes Saluran WhatsApp
        </h3>

        <p>
          Tambah up votes pada postingan saluran WhatsApp.
        </p>

        <div class="price">
          Mulai Rp6.000
        </div>

        <a
          class="order-btn"
          href="https://wa.me/6285165197664?text=Halo%20SMM Store%2C%20saya%20mau%20order%20Up%20Votes%20Saluran%20WhatsApp"
          target="_blank"
        >
          Order Sekarang
        </a>

      </div>

    </div>


    <!-- CARA ORDER -->
    <div class="info">

      <h3>
        📌 Cara Order
      </h3>

      <ul>
        <li>Pilih layanan yang ingin dibeli.</li>
        <li>Tekan tombol <b>Order Sekarang</b>.</li>
        <li>Kirim format pesanan melalui WhatsApp.</li>
        <li>Tunggu proses pesanan.</li>
      </ul>

    </div>

  </main>


  <!-- FOOTER -->
  <footer>
    © 2026 SMM Store
    <br>
    All Rights Reserved.
  </footer>

</body>
</html>
